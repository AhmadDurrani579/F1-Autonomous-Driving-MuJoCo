# Formula 1 MuJoCo simulation settings

MODEL="models/formula1_custom.xml"
VEHICLE="models/formula1.xml"
WAYPOINTS="tracks/oval_waypoints.csv"

CONTROLLER="pure_pursuit"

# Speeds in metres per second
MIN_SPEED=0.0
TARGET_SPEED=2.0
MAX_SPEED=5.0

# Controller settings
LOOKAHEAD_DISTANCE=5.0
CONTROL_FREQUENCY=50

# Initial sensor settings
LIDAR_ENABLED=false
CAMERA_ENABLED=false

# Simulator
TIMESTEP=0.002
